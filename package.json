{
  "name": "stellariq-app",
  "version": "0.1.0",
  "private": true,
  "description": "StellarIQ — Intelligence for Stellar DeFi. Product, API, SDK, Web and Contracts monorepo.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev": "pnpm dev:web",
    "dev:all": "pnpm dev:api & pnpm dev:web",
    "dev:web": "pnpm --filter @stellariq/web dev",
    "dev:api": "pnpm --filter @stellariq/api dev"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write"
    ],
    "apps/*/src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "packages/*/src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "8.57.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.6.2",
    "typescript": "^5.6.3"
  }
}
