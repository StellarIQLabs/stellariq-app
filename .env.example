# StellarIQ root environment — copy to .env and fill in per environment.
# Web (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# API (apps/api)
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
# Upstream data layer (stellariq-data / stellariq-contract repo). Mocked until available.
# TODO(data): point at real data API when upstream task lands.
DATA_API_URL=http://localhost:4100
DATABASE_URL=postgresql://stellariq:stellariq@localhost:5432/stellariq
REDIS_URL=redis://localhost:6379
API_KEY_SALT=change-me-in-production
