{
  "name": "@stellariq/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm --filter @stellariq/types --filter @stellariq/schemas --filter @stellariq/sdk --filter @stellariq/ui build && next build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "next start"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "13.3.0",
    "@stellariq/schemas": "workspace:^",
    "@stellariq/sdk": "workspace:^",
    "@stellariq/types": "workspace:^",
    "@stellariq/ui": "workspace:^",
    "clsx": "2.1.1",
    "lightweight-charts": "5.0.8",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.1",
    "@types/node": "22",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "jsdom": "26.1.0",
    "postcss": "8.5.3",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "vitest": "3.2.4"
  }
}
