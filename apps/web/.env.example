# Web app environment - copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Swap-router contract id. Leave unset until the contract is deployed.
NEXT_PUBLIC_SWAP_ROUTER_ID=
# StellarIQ Give donations contract (testnet default is built in).
NEXT_PUBLIC_DONATIONS_CONTRACT_ID=CBCHKIDRFJ4KO2DGJEP75NJPYN65YVD6QOVVHC5IU7PRTHGHW75OF2KX
