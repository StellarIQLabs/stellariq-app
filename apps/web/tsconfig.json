{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "moduleResolution": "Bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@stellariq/types": [
        "../../packages/types/src/index.ts"
      ],
      "@stellariq/schemas": [
        "../../packages/schemas/src/index.ts"
      ],
      "@stellariq/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@stellariq/sdk": [
        "../../packages/sdk/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.*",
    "src/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist"
  ]
}
