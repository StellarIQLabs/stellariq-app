# API service environment — copy to .env for local development.
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
# Upstream data layer (stellariq-data repo). Unset uses the built-in mock source.
# TODO(data): point at the real data API when the upstream task lands.
DATA_API_URL=
DATABASE_URL=postgresql://stellariq:stellariq@localhost:5432/stellariq
REDIS_URL=redis://localhost:6379
API_KEY_SALT=change-me-in-production
# Guards POST /v1/keys. Leave unset to disable HTTP key issuance.
ADMIN_TOKEN=
# Seed documented local-dev API keys (development only).
SEED_DEV_KEYS=false
# File path for persistent API key storage. Unset keeps keys in memory only.
# KEY_STORE_PATH=./data/keys.json
